# Copy this file to .env and fill in your values.  Do NOT commit .env to git.

# --- Discord ---------------------------------------------------------------
# Bot token (Developer Portal > your app > Bot > Reset/Copy Token)
DISCORD_TOKEN=put-your-token-here
# ID of the channel where the embed will be posted (enable Developer Mode in
# Discord, then right-click the channel > Copy Channel ID)
DISCORD_CHANNEL_ID=123456789012345678

# --- Navidrome (Subsonic API) ---------------------------------------------
# Base URL of your Navidrome (no trailing slash). Can be local.
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=your_username
NAVIDROME_PASS=your_password
# Optional: if your server has several users and you only want to show yours.
# If left empty, it uses NAVIDROME_USER.
NAVIDROME_USERNAME_FILTER=

# --- Settings (optional) ---------------------------------------------------
# How often (in seconds) it checks what's playing (minimum 5).
POLL_INTERVAL=15
# Minutes without a report after which playback is considered "idle".
IDLE_AFTER_MINUTES=10
# Embed color in hex (with or without #). Defaults to Discord's blurple.
EMBED_COLOR=5865F2
# Cover art size in px requested from Navidrome.
COVER_SIZE=512
# File where the message ID is stored to reuse it across restarts.
STATE_FILE=state.json
